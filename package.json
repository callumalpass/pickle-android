{
  "name": "pickle-app",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "manifest": "node scripts/write-manifest.mjs",
    "manifest:dev": "node scripts/write-manifest.mjs --development",
    "dev": "pnpm manifest:dev && vite",
    "deploy:dev": "node scripts/deploy-pages-dev.mjs",
    "build": "pnpm manifest && pnpm manifest:validate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:connect": "playwright test --config playwright.dogfood.config.ts",
    "test:android-smoke": "node scripts/android-smoke.mjs",
    "manifest:validate": "mdbase-connect-dev validate-manifest public/.well-known/mdbase-app.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "cap:sync": "pnpm build && cap sync android",
    "android": "pnpm cap:sync && cap run android"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/push-notifications": "8.0.2",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/azeret-mono": "5.3.0",
    "@mdbase-dev/connect": "file:vendor/mdbase-dev-connect-0.1.0-beta.71-b1b25a91c530.tgz",
    "@mdbase-dev/connect-protocol": "file:vendor/mdbase-dev-connect-protocol-0.1.0-beta.71-b1b25a91c530.tgz",
    "@mdbase-dev/pickle": "file:vendor/mdbase-dev-pickle-0.1.0-beta.71-b1b25a91c530.tgz",
    "lucide-react": "1.25.0",
    "pdfjs-dist": "5.4.149",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.4.2",
    "@eslint/js": "10.0.1",
    "@mdbase-dev/connect-dev": "file:vendor/mdbase-dev-connect-dev-0.1.0-beta.71-b1b25a91c530.tgz",
    "@mdbase-dev/connect-testing": "file:vendor/mdbase-dev-connect-testing-0.1.0-beta.71-b1b25a91c530.tgz",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "fake-indexeddb": "6.2.5",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
